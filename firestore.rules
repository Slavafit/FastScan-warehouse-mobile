rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function warehouseAccess(warehouseId) {
      return request.auth != null
        && request.auth.token.keys().hasAll([
          'warehouse_id', 'license_active', 'license_expires_at', 'auth_time'
        ])
        && request.auth.token.warehouse_id is string
        && request.auth.token.warehouse_id.size() > 0
        && request.auth.token.warehouse_id == warehouseId
        && request.auth.token.license_active == true
        && request.auth.token.license_expires_at is int
        && request.auth.token.auth_time is int
        && request.time.toMillis() < (request.auth.token.auth_time + 172800) * 1000
        && (request.auth.token.license_expires_at == 0
          || request.time.toMillis() < request.auth.token.license_expires_at * 1000);
    }

    match /warehouses/{warehouseId}/shipments/{document} {
      allow read, create, update: if warehouseAccess(warehouseId);
      allow delete: if false;
    }

    match /warehouses/{warehouseId}/box_entries/{document} {
      allow read, create, update: if warehouseAccess(warehouseId);
      allow delete: if false;
    }

    match /warehouses/{warehouseId}/shipment_daily/{day} {
      allow read: if warehouseAccess(warehouseId)
        && resource.data.warehouse_id == warehouseId;
      allow create: if warehouseAccess(warehouseId)
        && day.matches('\\d{4}-\\d{2}-\\d{2}')
        && request.resource.data.warehouse_id == warehouseId
        && request.resource.data.date == day
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.total_weight is number
        && request.resource.data.total_weight >= 0
        && request.resource.data.updated_at == request.time
        && request.resource.data.keys().hasOnly([
          'warehouse_id', 'date', 'count', 'total_weight', 'updated_at'
        ]);
      allow update: if warehouseAccess(warehouseId)
        && day.matches('\\d{4}-\\d{2}-\\d{2}')
        && resource.data.warehouse_id == warehouseId
        && request.resource.data.warehouse_id == warehouseId
        && request.resource.data.date == day
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.total_weight is number
        && request.resource.data.total_weight >= 0
        && request.resource.data.updated_at == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'count', 'total_weight', 'updated_at'
        ]);
      allow delete: if false;
    }

    match /warehouses/{warehouseId}/product_catalog/{document} {
      allow read, create, update: if warehouseAccess(warehouseId);
      allow delete: if false;
    }

    match /warehouses/{warehouseId}/order_contents/{document} {
      allow read, create, update: if warehouseAccess(warehouseId);
      allow delete: if false;
    }

    match /warehouses/{warehouseId}/box_inventory_reports/{document} {
      allow read, create: if warehouseAccess(warehouseId);
      allow update, delete: if false;
    }

    match /warehouses/{warehouseId}/client_search_daily/{day} {
      allow read: if warehouseAccess(warehouseId);
      allow create: if warehouseAccess(warehouseId)
        && request.resource.data.keys().hasOnly([
          'warehouse_id', 'date', 'total', 'found', 'not_found', 'error', 'updated_at'
        ])
        && request.resource.data.warehouse_id == warehouseId
        && request.resource.data.date == day
        && request.resource.data.total == 1
        && request.resource.data.get('found', 0)
          + request.resource.data.get('not_found', 0)
          + request.resource.data.get('error', 0) == 1;
      allow update: if warehouseAccess(warehouseId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'total', 'found', 'not_found', 'error', 'updated_at'
        ])
        && request.resource.data.total == resource.data.total + 1
        && request.resource.data.get('found', 0) >= resource.data.get('found', 0)
        && request.resource.data.get('not_found', 0) >= resource.data.get('not_found', 0)
        && request.resource.data.get('error', 0) >= resource.data.get('error', 0)
        && (request.resource.data.get('found', 0) - resource.data.get('found', 0))
          + (request.resource.data.get('not_found', 0) - resource.data.get('not_found', 0))
          + (request.resource.data.get('error', 0) - resource.data.get('error', 0)) == 1;
      allow delete: if false;
    }

    // Temporary compatibility for historical root documents, not subcollections.
    match /shipments/{shipmentId} {
      allow read: if warehouseAccess('es-main');
      allow write: if false;
    }
    match /box_entries/{entryId} {
      allow read: if warehouseAccess('es-main');
      allow write: if false;
    }

    // All remaining paths are denied; this grants no additional access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
