<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/app_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/input_track"
        android:textColor="@color/app_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearchTrack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:drawable/edit_text"
            android:hint="@string/for_example"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:textColor="@color/app_text_primary"
            android:textColorHint="@color/app_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanSearchTrack"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/scan_track"
            app:icon="@drawable/ic_scan" />

    </LinearLayout>

</LinearLayout>
